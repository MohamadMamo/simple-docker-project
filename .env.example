# Copy this file to .env and adjust as needed.
#
# NOTE: POSTGRES_* and DATABASE_URL both encode the same credentials
# (docker-compose's Postgres image needs the POSTGRES_* form, the app needs
# a full DATABASE_URL). They are NOT derived from each other - if you change
# one, change the other to match, or the app and the database will drift
# apart silently.

POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=mydatabase

DATABASE_URL=postgresql://user:password@db:5432/mydatabase
